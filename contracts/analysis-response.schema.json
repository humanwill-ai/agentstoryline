{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traceforge:analysis-response:0.1",
  "title": "Offline model interpretation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "stages"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "event_ids",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S+$"
            }
          },
          "basis": {
            "const": "interpretation"
          }
        }
      }
    }
  }
}
